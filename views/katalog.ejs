<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | Gudeg Go Enterprise</title>
    <!-- Font Inter untuk kesan profesional -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['Inter', 'sans-serif'] },
                    colors: { brand: { 500: '#4F46E5', 600: '#4338CA', 700: '#3730A3' } }
                }
            }
        }
    </script>
    <style>
        body { background-color: #F8FAFC; }
        .glass-panel { background: rgba(255, 255, 255, 0.9); backdrop-filter: blur(10px); }
        #chat-messages::-webkit-scrollbar { width: 5px; }
        #chat-messages::-webkit-scrollbar-track { background: transparent; }
        #chat-messages::-webkit-scrollbar-thumb { background: #CBD5E1; border-radius: 10px; }
    </style>
</head>
<body class="min-h-screen text-slate-800 antialiased relative">
    
    <!-- NAVBAR -->
    <nav class="bg-white border-b border-slate-200 sticky top-0 z-40 shadow-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16 items-center">
                <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-lg bg-brand-600 flex items-center justify-center text-white font-bold text-xl shadow-md">G</div>
                    <h1 class="text-xl font-bold text-slate-900 tracking-tight">Gudeg Go <span class="text-slate-400 font-normal text-sm ml-2 px-2 py-0.5 bg-slate-100 rounded-md">Admin Panel</span></h1>
                </div>
                <div class="flex items-center gap-6">
                    <a href="/" class="text-sm font-medium text-slate-500 hover:text-brand-600 transition-colors">Lihat Toko</a>
                    <a href="/katalog" class="text-sm font-medium text-brand-600 bg-indigo-50 px-3 py-2 rounded-md">Kelola Katalog</a>
                </div>
            </div>
        </div>
    </nav>

    <!-- KONTEN UTAMA -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        
        <div class="mb-8 flex justify-between items-end">
            <div>
                <h2 class="text-2xl font-bold text-slate-900">Manajemen Produk</h2>
                <p class="text-sm text-slate-500 mt-1">Kelola inventaris, harga, dan ketersediaan stok Gudeg Go.</p>
            </div>
        </div>

        <!-- STATISTIC CARDS -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
            <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm font-medium text-slate-500">Total Produk</p>
                        <p class="text-2xl font-bold text-slate-900 mt-1"><%= produk.length %></p>
                    </div>
                    <div class="w-12 h-12 bg-indigo-50 rounded-full flex items-center justify-center text-indigo-600">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path></svg>
                    </div>
                </div>
            </div>
            <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm font-medium text-slate-500">Stok Tersedia</p>
                        <p class="text-2xl font-bold text-slate-900 mt-1"><%= produk.reduce((acc, item) => acc + item.stok, 0) %> pcs</p>
                    </div>
                    <div class="w-12 h-12 bg-emerald-50 rounded-full flex items-center justify-center text-emerald-600">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                    </div>
                </div>
            </div>
            <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm font-medium text-slate-500">Produk Habis</p>
                        <p class="text-2xl font-bold text-slate-900 mt-1"><%= produk.filter(p => p.stok === 0).length %></p>
                    </div>
                    <div class="w-12 h-12 bg-red-50 rounded-full flex items-center justify-center text-red-600">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
                    </div>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            
            <!-- KOLOM KIRI: FORM TAMBAH/EDIT -->
            <div class="lg:col-span-1">
                <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6 sticky top-24">
                    <h3 class="text-lg font-semibold text-slate-900 mb-4 pb-4 border-b border-slate-100">
                        <%= typeof editData !== 'undefined' && editData ? 'Edit Informasi Produk' : 'Tambah Produk Baru' %>
                    </h3>
                    
                    <form action="<%= typeof editData !== 'undefined' && editData ? '/katalog/edit/' + editData.id : '/katalog/tambah' %>" method="POST" class="space-y-4">
                        <div>
                            <label class="block text-sm font-medium text-slate-700 mb-1">Nama Produk</label>
                            <input type="text" name="nama" value="<%= typeof editData !== 'undefined' && editData ? editData.nama : '' %>" required class="w-full bg-slate-50 border border-slate-300 rounded-lg px-4 py-2.5 text-slate-900 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent transition-all" placeholder="Contoh: Gudeg Kaleng Spesial">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-slate-700 mb-1">Harga (Rp)</label>
                            <div class="relative">
                                <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-slate-500 font-medium">Rp</span>
                                <input type="number" name="harga" min="0" step="1" placeholder="45000" value="<%= typeof editData !== 'undefined' && editData ? editData.harga : '' %>" required class="w-full bg-slate-50 border border-slate-300 rounded-lg pl-10 pr-4 py-2.5 text-slate-900 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent transition-all">
                            </div>
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-slate-700 mb-1">Jumlah Stok</label>
                            <input type="number" name="stok" min="0" step="1" placeholder="20" value="<%= typeof editData !== 'undefined' && editData ? editData.stok : '' %>" required class="w-full bg-slate-50 border border-slate-300 rounded-lg px-4 py-2.5 text-slate-900 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent transition-all">
                        </div>
                        <div class="pt-2 flex flex-col gap-2">
                            <button type="submit" class="w-full bg-brand-600 hover:bg-brand-700 text-white font-semibold py-2.5 px-4 rounded-lg shadow-sm transition-all">
                                <%= typeof editData !== 'undefined' && editData ? 'Simpan Perubahan' : 'Simpan Produk' %>
                            </button>
                            <% if(typeof editData !== 'undefined' && editData) { %>
                                <a href="/katalog" class="w-full bg-white border border-slate-300 hover:bg-slate-50 text-slate-700 font-semibold py-2.5 px-4 rounded-lg text-center transition-all">Batal Edit</a>
                            <% } %>
                        </div>
                    </form>
                </div>
            </div>

            <!-- KOLOM KANAN: TABEL DATA -->
            <div class="lg:col-span-2">
                <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
                    <div class="p-6 border-b border-slate-100 flex justify-between items-center">
                        <h3 class="text-lg font-semibold text-slate-900">Daftar Inventaris</h3>
                        <span class="bg-indigo-50 text-brand-600 text-xs font-bold px-3 py-1 rounded-full"><%= produk.length %> Item</span>
                    </div>
                    
                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse">
                            <thead class="bg-slate-50 border-b border-slate-200">
                                <tr>
                                    <th class="py-3 px-6 text-xs font-semibold text-slate-500 uppercase tracking-wider">Produk</th>
                                    <th class="py-3 px-6 text-xs font-semibold text-slate-500 uppercase tracking-wider">Harga</th>
                                    <th class="py-3 px-6 text-xs font-semibold text-slate-500 uppercase tracking-wider">Stok</th>
                                    <th class="py-3 px-6 text-xs font-semibold text-slate-500 uppercase tracking-wider text-right">Aksi</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100">
                                <% produk.forEach((item) => { %>
                                    <tr class="hover:bg-slate-50 transition-colors">
                                        <td class="py-4 px-6">
                                            <div class="flex items-center gap-4">
                                                <!-- GAMBAR PRODUK (Lokasi disesuaikan menjadi /gudeg.jpg) -->
                                                <img src="/gudeg.jpg" alt="Gudeg Kaleng" class="w-12 h-12 rounded-lg object-cover border border-slate-200 bg-white shadow-sm">
                                                <div>
                                                    <div class="font-medium text-slate-900"><%= item.nama %></div>
                                                    <div class="text-xs text-slate-500 mt-0.5">ID: #<%= item.id %></div>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="py-4 px-6 text-slate-600 font-medium font-mono">
                                            Rp <%= item.harga.toLocaleString('id-ID') %>
                                        </td>
                                        <td class="py-4 px-6">
                                            <% if(item.stok > 0) { %>
                                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-emerald-100 text-emerald-800 border border-emerald-200">
                                                    <%= item.stok %> Tersedia
                                                </span>
                                            <% } else { %>
                                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800 border border-red-200">
                                                    Habis
                                                </span>
                                            <% } %>
                                        </td>
                                        <td class="py-4 px-6 text-right">
                                            <div class="flex justify-end gap-2">
                                                <a href="/katalog/edit/<%= item.id %>" class="text-slate-400 hover:text-brand-600 transition-colors p-1" title="Edit">
                                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                                                </a>
                                                <form action="/katalog/hapus/<%= item.id %>" method="POST" onsubmit="return confirm('Apakah Anda yakin ingin menghapus produk ini?');" class="inline">
                                                    <button type="submit" class="text-slate-400 hover:text-red-600 transition-colors p-1" title="Hapus">
                                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <!-- WIDGET AI ASSISTANT -->
    <button id="chat-toggle" class="fixed bottom-6 right-6 bg-slate-900 hover:bg-slate-800 text-white p-4 rounded-full shadow-lg z-50 transition-transform hover:-translate-y-1 flex items-center justify-center">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" /></svg>
    </button>

    <div id="chat-window" class="hidden fixed bottom-24 right-6 w-80 md:w-96 bg-white border border-slate-200 rounded-xl shadow-2xl z-50 flex flex-col overflow-hidden transition-all duration-300">
        <div class="bg-white border-b border-slate-100 p-4 flex justify-between items-center">
            <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-full bg-indigo-100 flex items-center justify-center text-brand-600"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg></div>
                <div><h3 class="font-bold text-slate-900 text-sm">Asisten Virtual</h3><p class="text-xs text-emerald-500 font-medium flex items-center gap-1"><span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Online</p></div>
            </div>
            <button id="chat-close" class="text-slate-400 hover:text-slate-600 font-bold text-xl leading-none">&times;</button>
        </div>
        <div id="chat-messages" class="p-4 h-80 overflow-y-auto flex flex-col gap-4 text-sm bg-slate-50">
            <div class="flex gap-2">
                <div class="w-6 h-6 rounded-full bg-brand-600 flex-shrink-0 flex items-center justify-center text-white text-xs font-bold mt-1">AI</div>
                <div class="bg-white border border-slate-200 text-slate-700 p-3 rounded-2xl rounded-tl-sm w-4/5 shadow-sm">Halo! Saya asisten AI Gudeg Go. Ada yang bisa saya bantu?</div>
            </div>
        </div>
        <div class="p-3 border-t border-slate-100 bg-white">
            <div class="flex gap-2 relative">
                <input type="text" id="chat-input" placeholder="Ketik pertanyaan Anda..." class="w-full bg-slate-100 border border-transparent rounded-full px-4 py-2.5 text-slate-700 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:bg-white transition-all">
                <button id="chat-send" class="absolute right-1 top-1 bottom-1 bg-brand-600 hover:bg-brand-700 text-white px-3 rounded-full transition-all flex items-center justify-center"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path></svg></button>
            </div>
        </div>
    </div>

    <!-- SCRIPT LOGIC CHAT -->
    <script>
        const chatToggle = document.getElementById('chat-toggle');
        const chatWindow = document.getElementById('chat-window');
        const chatClose = document.getElementById('chat-close');
        const chatInput = document.getElementById('chat-input');
        const chatSend = document.getElementById('chat-send');
        const chatMessages = document.getElementById('chat-messages');

        chatToggle.addEventListener('click', () => { chatWindow.classList.toggle('hidden'); if(!chatWindow.classList.contains('hidden')) chatInput.focus(); });
        chatClose.addEventListener('click', () => { chatWindow.classList.add('hidden'); });

        function addMessage(text, isUser) {
            const div = document.createElement('div');
            div.className = isUser ? "flex gap-2 justify-end" : "flex gap-2";
            const avatar = isUser ? "" : `<div class="w-6 h-6 rounded-full bg-brand-600 flex-shrink-0 flex items-center justify-center text-white text-xs font-bold mt-1">AI</div>`;
            const bubbleClass = isUser ? "bg-brand-600 text-white p-3 rounded-2xl rounded-tr-sm w-4/5 shadow-sm" : "bg-white border border-slate-200 text-slate-700 p-3 rounded-2xl rounded-tl-sm w-4/5 shadow-sm";
            div.innerHTML = `${avatar}<div class="${bubbleClass}">${text.replace(/\n/g, '<br>')}</div>`;
            chatMessages.appendChild(div);
            chatMessages.scrollTop = chatMessages.scrollHeight;
        }

        function showLoading() {
            const id = "loading-" + Date.now();
            const div = document.createElement('div');
            div.id = id;
            div.className = "flex gap-2";
            div.innerHTML = `<div class="w-6 h-6 rounded-full bg-brand-600 flex-shrink-0 flex items-center justify-center text-white text-xs font-bold mt-1">AI</div><div class="bg-white border border-slate-200 p-3 rounded-2xl rounded-tl-sm w-max shadow-sm flex gap-1 items-center"><span class="w-1.5 h-1.5 bg-slate-400 rounded-full animate-bounce"></span><span class="w-1.5 h-1.5 bg-slate-400 rounded-full animate-bounce" style="animation-delay: 0.1s"></span><span class="w-1.5 h-1.5 bg-slate-400 rounded-full animate-bounce" style="animation-delay: 0.2s"></span></div>`;
            chatMessages.appendChild(div);
            chatMessages.scrollTop = chatMessages.scrollHeight;
            return id;
        }

        async function sendMessage() {
            const message = chatInput.value.trim();
            if (!message) return;
            addMessage(message, true);
            chatInput.value = '';
            const loadingId = showLoading();
            try {
                const response = await fetch('/api/chat', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ message: message })
                });
                const data = await response.json();
                document.getElementById(loadingId).remove();
                if (data.success) { addMessage(data.data.reply, false); } 
                else { addMessage("⚠️ " + (data.message || "Terjadi kesalahan sistem."), false); }
            } catch (error) {
                document.getElementById(loadingId).remove();
                addMessage("⚠️ Gagal terhubung ke server.", false);
            }
        }

        chatSend.addEventListener('click', sendMessage);
        chatInput.addEventListener('keypress', (e) => { if (e.key === 'Enter') sendMessage(); });
    </script>
</body>
</html>