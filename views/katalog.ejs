<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        body { background-color: #1a120b; color: #f8fafc; }
        .glass { background: rgba(45, 30, 20, 0.8); backdrop-filter: blur(10px); border: 1px solid rgba(255, 215, 0, 0.2); }
        .gold-text { color: #fbbf24; }
    </style>
</head>
<body class="min-h-screen font-sans">
    
    <!-- NAVBAR -->
    <nav class="glass sticky top-0 z-50 p-4 shadow-lg mb-8">
        <div class="max-w-5xl mx-auto flex justify-between items-center">
            <h1 class="text-2xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-yellow-400 to-amber-600">
                Gudeg Go
            </h1>
            <div class="flex gap-6 text-sm font-semibold text-amber-200/70">
                <a href="/" class="hover:text-amber-400 transition-colors">Home</a>
                <a href="/katalog" class="text-amber-500">Katalog Menu</a>
            </div>
        </div>
    </nav>

    <div class="max-w-5xl mx-auto p-8 pt-0">
        <!-- Tabel Produk (Katalog) -->
        <div class="glass rounded-2xl p-6 shadow-2xl mb-8">
            <div class="flex items-center justify-between mb-6">
                <h2 class="text-2xl font-bold text-white flex items-center gap-2">
                    🍱 Katalog Menu Gudeg
                </h2>
                <div class="flex items-center gap-2">
                    <span class="relative flex h-3 w-3">
                        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
                        <span class="relative inline-flex rounded-full h-3 w-3 bg-green-500"></span>
                    </span>
                    <span class="text-green-400 font-semibold text-sm">Stok Real-time</span>
                </div>
            </div>
            
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="text-amber-200/70 border-b border-amber-800/50">
                            <th class="py-3 px-4">ID</th>
                            <th class="py-3 px-4">Nama Produk</th>
                            <th class="py-3 px-4">Harga</th>
                            <th class="py-3 px-4">Status</th>
                            <th class="py-3 px-4">Aksi</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% produk.forEach((item) => { %>
                            <tr class="border-b border-amber-900/30 hover:bg-amber-900/20 transition-colors duration-200">
                                <td class="py-4 px-4 text-amber-500">#<%= item.id %></td>
                                <td class="py-4 px-4 font-semibold text-white"><%= item.nama %></td>
                                <td class="py-4 px-4 gold-text">Rp <%= item.harga.toLocaleString('id-ID') %></td>
                                <td class="py-4 px-4">
                                    <% if(item.stok > 0) { %>
                                        <span class="bg-green-900/50 text-green-400 py-1 px-3 rounded-full text-xs font-bold border border-green-700">Tersedia (<%= item.stok %>)</span>
                                    <% } else { %>
                                        <span class="bg-red-900/50 text-red-400 py-1 px-3 rounded-full text-xs font-bold border border-red-700">Stok Habis</span>
                                    <% } %>
                                </td>
                                <td class="py-4 px-4">
                                    <button class="<%= item.stok > 0 ? 'bg-amber-600 hover:bg-amber-500 text-white cursor-pointer' : 'bg-gray-700 text-gray-500 cursor-not-allowed' %> px-4 py-2 rounded-lg text-sm font-bold transition-all" <%= item.stok > 0 ? '' : 'disabled' %>>
                                        <%= item.stok > 0 ? 'Pesan' : 'Habis' %>
                                    </button>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- FORM CHECKOUT SEDERHANA (Sesuai US-04 PRD) -->
        <div class="glass rounded-2xl p-6 shadow-2xl">
            <h2 class="text-2xl font-bold text-white mb-6 flex items-center gap-2">
                🛒 Form Pemesanan & Pengambilan
            </h2>
            <form action="#" method="GET" class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label class="block text-sm font-medium text-amber-200/70 mb-2">Nama Pemesan</label>
                    <input type="text" placeholder="Masukkan nama Anda" class="w-full bg-[#2d1e14] border border-amber-800/50 rounded-lg px-4 py-3 text-white focus:outline-none focus:border-amber-500">
                </div>
                <div>
                    <label class="block text-sm font-medium text-amber-200/70 mb-2">Metode Pengambilan</label>
                    <select class="w-full bg-[#2d1e14] border border-amber-800/50 rounded-lg px-4 py-3 text-white focus:outline-none focus:border-amber-500">
                        <option>Pickup di Outlet (Gudeg Yu Djum)</option>
                        <option>Antar Area Yogyakarta</option>
                    </select>
                </div>
                <div class="md:col-span-2 mt-2">
                    <button type="button" class="w-full bg-gradient-to-r from-amber-600 to-yellow-600 hover:from-amber-500 hover:to-yellow-500 text-white font-bold py-3 px-4 rounded-lg transition-all">
                        Lanjut ke Pembayaran (QRIS/Transfer)
                    </button>
                </div>
            </form>
        </div>
    </div>
</body>
</html>