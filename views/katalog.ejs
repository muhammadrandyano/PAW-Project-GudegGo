<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        body { background-color: #1a120b; color: #f8fafc; }
        .glass { background: rgba(45, 30, 20, 0.8); backdrop-filter: blur(10px); border: 1px solid rgba(255, 215, 0, 0.2); }
        .gold-text { color: #fbbf24; }
    </style>
</head>
<body class="min-h-screen font-sans">
    
    <!-- NAVBAR -->
    <nav class="glass sticky top-0 z-50 p-4 shadow-lg mb-8">
        <div class="max-w-5xl mx-auto flex justify-between items-center">
            <h1 class="text-2xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-yellow-400 to-amber-600">
                Gudeg Go - Admin
            </h1>
            <div class="flex gap-6 text-sm font-semibold text-amber-200/70">
                <a href="/" class="hover:text-amber-400 transition-colors">Home</a>
                <a href="/katalog" class="text-amber-500">Kelola Katalog</a>
            </div>
        </div>
    </nav>

    <div class="max-w-5xl mx-auto p-8 pt-0">
        
        <!-- FORM TAMBAH & EDIT PRODUK -->
        <div class="glass rounded-2xl p-6 shadow-2xl mb-8 border-t-4 border-amber-500">
            <h2 class="text-xl font-bold text-white mb-4">
                <%= typeof editData !== 'undefined' && editData ? '✏️ Edit Produk' : '➕ Tambah Produk Baru' %>
            </h2>
            <!-- Jika editData ada, arahkan ke route edit. Jika tidak, ke route tambah -->
            <form action="<%= typeof editData !== 'undefined' && editData ? '/katalog/edit/' + editData.id : '/katalog/tambah' %>" method="POST" class="grid grid-cols-1 md:grid-cols-4 gap-4">
                <div>
                    <label class="block text-xs font-medium text-amber-200/70 mb-1">Nama Produk</label>
                    <input type="text" name="nama" value="<%= typeof editData !== 'undefined' && editData ? editData.nama : '' %>" required class="w-full bg-[#2d1e14] border border-amber-800/50 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-amber-500">
                </div>
                <div>
                    <label class="block text-xs font-medium text-amber-200/70 mb-1">Harga (Rp)</label>
                    <input type="number" name="harga" value="<%= typeof editData !== 'undefined' && editData ? editData.harga : '' %>" required class="w-full bg-[#2d1e14] border border-amber-800/50 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-amber-500">
                </div>
                <div>
                    <label class="block text-xs font-medium text-amber-200/70 mb-1">Stok</label>
                    <input type="number" name="stok" value="<%= typeof editData !== 'undefined' && editData ? editData.stok : '' %>" required class="w-full bg-[#2d1e14] border border-amber-800/50 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-amber-500">
                </div>
                <div class="flex items-end gap-2">
                    <button type="submit" class="w-full bg-amber-600 hover:bg-amber-500 text-white font-bold py-2 px-4 rounded-lg transition-all">
                        <%= typeof editData !== 'undefined' && editData ? 'Simpan Perubahan' : 'Tambah Data' %>
                    </button>
                    <% if(typeof editData !== 'undefined' && editData) { %>
                        <a href="/katalog" class="bg-gray-600 hover:bg-gray-500 text-white font-bold py-2 px-4 rounded-lg text-center">Batal</a>
                    <% } %>
                </div>
            </form>
        </div>

        <!-- Tabel Produk (Katalog) -->
        <div class="glass rounded-2xl p-6 shadow-2xl">
            <h2 class="text-2xl font-bold text-white mb-6 flex items-center gap-2">
                🍱 Data Katalog (Database PostgreSQL)
            </h2>
            
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="text-amber-200/70 border-b border-amber-800/50">
                            <th class="py-3 px-4">ID</th>
                            <th class="py-3 px-4">Nama Produk</th>
                            <th class="py-3 px-4">Harga</th>
                            <th class="py-3 px-4">Stok</th>
                            <th class="py-3 px-4 text-center">Aksi</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% produk.forEach((item) => { %>
                            <tr class="border-b border-amber-900/30 hover:bg-amber-900/20 transition-colors duration-200">
                                <td class="py-4 px-4 text-amber-500">#<%= item.id %></td>
                                <td class="py-4 px-4 font-semibold text-white"><%= item.nama %></td>
                                <td class="py-4 px-4 gold-text">Rp <%= item.harga.toLocaleString('id-ID') %></td>
                                <td class="py-4 px-4">
                                    <span class="<%= item.stok > 0 ? 'bg-green-900/50 text-green-400 border-green-700' : 'bg-red-900/50 text-red-400 border-red-700' %> py-1 px-3 rounded-full text-xs font-bold border">
                                        <%= item.stok %> pcs
                                    </span>
                                </td>
                                <td class="py-4 px-4 flex justify-center gap-2">
                                    <!-- Tombol Edit: Kirim ID ke backend untuk diambil datanya -->
                                    <form action="/katalog/edit/<%= item.id %>" method="GET">
                                        <button type="submit" class="bg-blue-600 hover:bg-blue-500 text-white px-3 py-1 rounded text-xs font-bold transition-all">Edit</button>
                                    </form>
                                    <!-- Tombol Hapus -->
                                    <form action="/katalog/hapus/<%= item.id %>" method="POST" onsubmit="return confirm('Yakin ingin menghapus produk ini?');">
                                        <button type="submit" class="bg-red-600 hover:bg-red-500 text-white px-3 py-1 rounded text-xs font-bold transition-all">Hapus</button>
                                    </form>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</body>
</html>