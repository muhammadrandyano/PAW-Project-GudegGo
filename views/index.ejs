<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        body { background-color: #1a120b; color: #f8fafc; }
        .glass { background: rgba(45, 30, 20, 0.8); backdrop-filter: blur(10px); border: 1px solid rgba(255, 215, 0, 0.2); }
        .gold-text { color: #fbbf24; }
    </style>
</head>
<body class="min-h-screen font-sans flex flex-col">
    
    <!-- NAVBAR -->
    <nav class="glass sticky top-0 z-50 p-4 shadow-lg">
        <div class="max-w-5xl mx-auto flex justify-between items-center">
            <h1 class="text-2xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-yellow-400 to-amber-600">
                Gudeg Go
            </h1>
            <div class="flex gap-6 text-sm font-semibold text-amber-200/70">
                <a href="/" class="text-amber-500">Home</a>
                <a href="/katalog" class="hover:text-amber-400 transition-colors">Katalog Menu</a>
            </div>
        </div>
    </nav>

    <!-- HERO SECTION HOMEPAGE -->
    <main class="flex-grow flex items-center justify-center p-8">
        <div class="max-w-3xl text-center">
            <h1 class="text-6xl font-extrabold text-white mb-6 leading-tight">
                Bawa Pulang <span class="gold-text">Oleh-Oleh Legendaris</span> Jogja
            </h1>
            <p class="text-lg text-amber-200/70 mb-10 max-w-2xl mx-auto">
                Pesan Gudeg Yu Djum tanpa perlu antri. Cek ketersediaan stok secara real-time dan pilih metode pengambilan sesuai rencana perjalananmu.
            </p>
            <div class="flex justify-center gap-4">
                <a href="/katalog" class="bg-amber-600 hover:bg-amber-500 text-white font-bold py-4 px-10 rounded-full transition-all shadow-[0_0_20px_rgba(217,119,6,0.5)] transform hover:scale-105">
                    Lihat Menu & Pesan
                </a>
            </div>
        </div>
    </main>

    <!-- FOOTER -->
    <footer class="text-center p-6 text-amber-500/40 text-sm border-t border-amber-900/30">
        &copy; 2026 Gudeg Go - Tugas PPAW Week 7.
    </footer>
</body>
</html>